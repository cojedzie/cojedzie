{
  "name": "kadet/cojedzie",
  "description": "Co Jedzie",
  "type": "project",
  "license": "AGPL-3.0-only",
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "baldinof/roadrunner-bundle": "^3.5",
    "doctrine/doctrine-bundle": "^3.3",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^3.7",
    "dragonmantank/cron-expression": "^3.3",
    "friendsofphp/proxy-manager-lts": "^1.0",
    "kadet/functional": "^1.0.1",
    "nelmio/api-doc-bundle": "^5.13",
    "nelmio/cors-bundle": "^2.5",
    "nesbot/carbon": "^3.0",
    "nyholm/psr7": "^1.5",
    "php-ds/php-ds": "^2.0",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpstan/phpdoc-parser": "^2.0",
    "sentry/sentry-symfony": "^5.14",
    "symfony/amqp-messenger": "8.1.*",
    "symfony/asset": "^8.1",
    "symfony/clock": "8.1.*",
    "symfony/console": "^8.1",
    "symfony/doctrine-messenger": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/flex": "^2.4",
    "symfony/form": "8.1.*",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-client": "8.1.*",
    "symfony/mercure-bundle": "^0.6",
    "symfony/messenger": "8.1.*",
    "symfony/monolog-bundle": "^4.1",
    "symfony/property-access": "8.1.*",
    "symfony/property-info": "8.1.*",
    "symfony/redis-messenger": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/scheduler": "8.1.*",
    "symfony/serializer": "8.1.*",
    "symfony/twig-bundle": "^8.1",
    "symfony/uid": "8.1.*",
    "symfony/validator": "8.1.*",
    "symfony/yaml": "^8.1"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "secure-http": false,
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true,
      "php-http/discovery": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "./src/Functions/index.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php71": "*",
    "symfony/polyfill-php70": "*",
    "symfony/polyfill-php56": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "8.1.*"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://git.kadet.net/kadet/functional-php.git"
    }
  ],
  "require-dev": {
    "behat/behat": "^4.0",
    "dama/doctrine-test-bundle": "^8.7",
    "doctrine/doctrine-fixtures-bundle": "^3.6 || ^4.0",
    "friends-of-behat/symfony-extension": "^2.7",
    "phpbench/phpbench": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^13.4",
    "rector/rector": "^2.7",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*",
    "symfony/maker-bundle": "^1.61",
    "symfony/phpunit-bridge": "^8.1",
    "symfony/stopwatch": "8.1.*",
    "symfony/web-profiler-bundle": "8.1.*",
    "symplify/easy-coding-standard": "^13.0"
  }
}
